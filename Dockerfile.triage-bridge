FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Runtime deps (ADR 0061: classification runs in-process here now, not in a
# Reasoning Engine — the bridge owns the full classify + write chain):
#  - google-cloud-pubsub (pull from asb-triage-input-sub)
#  - google-cloud-bigquery (write triaged_items + audit rows)
#  - google-genai (Gemini classify via VertexClassifier — genai.Client(vertexai=True))
#  - google-cloud-secret-manager (read the Airtable write PAT)
#  - requests (AirtableTasksWriteClient POSTs the drafted Task)
COPY pyproject.toml ./
RUN pip install \
    "google-cloud-bigquery>=3.20" \
    "google-cloud-pubsub>=2.21" \
    "google-genai>=1.0" \
    "google-cloud-secret-manager>=2.20" \
    "google-auth>=2.32" \
    "requests>=2.32"

# Source only — no schema.json or scripts needed for the bridge.
COPY src/ ./src/

ENV PYTHONPATH=/app/src

# Cloud Run Jobs require a non-root user.
USER nobody

CMD ["python", "-m", "agency_brain.agents.triage.bridge"]
