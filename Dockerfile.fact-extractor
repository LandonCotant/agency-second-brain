FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Runtime deps. The fact extractor (ADR 0070) needs:
#  - google-cloud-bigquery (scan notes, resolve entity, write facts + watermark)
#  - google-cloud-aiplatform + google-genai (Vertex Gemini structured response)
#
# Drafts-only: no Gmail/Drive/Chat/Secret-Manager deps — it never dispatches.
# Per CLAUDE.md codebase gotchas: each agent pins its own deps.
COPY pyproject.toml ./
RUN pip install \
    "google-cloud-bigquery>=3.20" \
    "google-cloud-aiplatform>=1.46" \
    "google-genai>=1.0.0"

COPY src/ ./src/

ENV PYTHONPATH=/app/src

USER nobody

CMD ["python", "-m", "agency_brain.agents.fact_extractor.main"]
