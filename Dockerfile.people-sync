FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Runtime deps for the People Sync agent (ADR 0057). The agent:
#  - Reads airtable_replica.{accounts,contacts} from BQ (google-cloud-bigquery)
#  - Lists + reads + creates + updates markdown files in Drive
#    (google-api-python-client + google-auth via folder-share + ADC,
#    ADR 0044)
#  - Emits audit rows to agent_audit_log (google-cloud-bigquery)
#  - Parses + emits YAML frontmatter (PyYAML)
#
# Per CLAUDE.md "Codebase gotchas": every cross-boundary import lands here.
COPY pyproject.toml ./
RUN pip install \
    "google-cloud-bigquery>=3.20" \
    "google-api-python-client>=2.140" \
    "google-auth>=2.32" \
    "PyYAML>=6.0"

# Source only — no prompts / templates ship at runtime for this agent.
COPY src/ ./src/

ENV PYTHONPATH=/app/src

# Cloud Run Jobs require a non-root user.
USER nobody

CMD ["python", "-m", "agency_brain.agents.people_sync.main"]
