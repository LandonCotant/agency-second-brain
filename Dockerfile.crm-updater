FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Runtime deps for the CRM Auto-updater (ADR 0047):
#  - google-cloud-bigquery   (HIPAA domains, account list, audit log,
#                             crm_updater_runs checkpoint)
#  - google-cloud-aiplatform (Vertex Flash for entity extraction)
#  - google-genai            (google.genai.Client(vertexai=True))
#  - google-api-python-client (Gmail v1: list, get, modify-labels)
#  - google-auth             (DWD impersonation of asb-agent-triage-sa)
#  - google-cloud-secret-manager (Airtable PAT)
#  - requests                (Airtable HTTP)
COPY pyproject.toml ./
RUN pip install \
    "google-cloud-bigquery>=3.20" \
    "google-cloud-aiplatform>=1.46" \
    "google-genai>=1.0" \
    "google-api-python-client>=2.140" \
    "google-auth>=2.32" \
    "google-cloud-secret-manager>=2.20" \
    "requests>=2.32"

COPY src/ ./src/
ENV PYTHONPATH=/app/src

USER nobody

CMD ["python", "-m", "agency_brain.agents.crm_updater.main"]
